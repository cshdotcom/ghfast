DATABASE_URL="file:../db/custom.db"

# 可选:显式声明对外访问域名(Serverless/反代改写 Host 头时必须配置)
# 影响:docker realm、页面 pull 命令拼接、加速直链展示
# 示例:GHFAST_PUBLIC_ORIGIN="https://ghft.example.com"
# GHFAST_PUBLIC_ORIGIN=""

# 等价的环境变量替代方案:db/ghfast.config.json 的 publicOrigin 字段
# (部署平台无法注入环境变量时使用;env 优先于该文件):
#   { "publicOrigin": "https://ghft.example.com" }
